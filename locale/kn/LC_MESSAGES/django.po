#, python-format
msgid ""
"That would bring the total to %(total)s, more than the %(planned)s planned "
"for this. Check with your supervisor."
msgstr ""
"ಇದರಿಂದ ಒಟ್ಟು %(total)s ಆಗುತ್ತದೆ, ಇದು ಯೋಜಿಸಿದ %(planned)s ಗಿಂತ ಹೆಚ್ಚು. ನಿಮ್ಮ "
"ಸೂಪರ್‌ವೈಸರ್ ಅವರನ್ನು ಕೇಳಿ."

#, python-format
msgid "Updated %(op)s for %(day)s to %(qty)s."
